# RecallAI Enterprise Environment Configuration

# Database
DATABASE_URL=sqlite:///./database/recallai.db

# Azure OpenAI Service (Optional - built-in autonomous reasoning engine active by default)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Standard OpenAI API (Optional alternative)
OPENAI_API_KEY=

# Microsoft Entra ID (Azure AD) SSO & RBAC
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Azure AI Search / Hybrid Vector Store
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=recallai-memory-index

# Azure Blob Storage (for attachments & diagnostic traces)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=support-diagnostics
